---
import BaseLayout from './BaseLayout.astro';
import EarlMark from '../components/EarlMark.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TagPill from '../components/TagPill.astro';
import Byline from '../components/Byline.astro';
// hashText: the shared content-hash so the Questions box + each question get the same eb-<hash>
// anchor ids the rehype stamper / comment reconcile use. The Questions aside lives HERE (outside
// the content rehype sees), so it must be stamped in this layout to be commentable.
import { hashText } from '../lib/anchor-core.mjs';
const ebId = (text: string) => `eb-${hashText((text || '').replace(/\s+/g, ' ').trim())}`;

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags: string[];
  authors: string[];
  questions: string[];
  readingTime: number;
  postCommit?: string;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  tags,
  authors,
  questions,
  readingTime,
  postCommit,
} = Astro.props;
const kicker = tags[0] ?? 'Blog post';
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  publishedTime={pubDate}
>
  <article class="article" data-post-commit={postCommit}>
    <header class="post-header">
      <div class="brand-row">
        <span class="mark"><EarlMark size={24} /></span>
        <span class="brand-name">EarlBear</span>
        <span class="divider"></span>
        <span class="eyebrow">{kicker}</span>
      </div>
      <h1>{title}</h1>
      <div class="meta">
        {authors.length > 0 && (
          <>
            <Byline authorIds={authors} /> ·{' '}
          </>
        )}
        <FormattedDate date={pubDate} /> · {readingTime} min read
        {
          updatedDate && (
            <>
              {' · updated '}
              <FormattedDate date={updatedDate} />
            </>
          )
        }
      </div>
    </header>

    <aside
      class="questions"
      aria-label="Questions this post answers"
      id={ebId('Questions this post answers ' + questions.join(' '))}
      data-anchor-kind="component"
    >
      <h2>Questions this post answers</h2>
      <ul>
        {questions.map((q) => (
          <li id={ebId(q)} data-anchor-kind="row">{q}</li>
        ))}
      </ul>
    </aside>

    <div class="prose">
      <slot />
    </div>

    <footer class="post-footer">
      <div class="tags">
        {tags.map((tag) => <TagPill tag={tag} />)}
      </div>
      <a class="back" href="/">← All posts</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .article {
    /* Fill 65% of the viewport width, capped on ultra-wide so lines don't sprawl,
       and floored so it never gets narrower than the old reading measure. */
    /* border-box is load-bearing, not tidying. Under the default content-box these
       three declarations contradicted each other on a phone: at 375px, 65vw is 244px
       so the min-width floor won at min(100%, reading) = 100% = 359px — and then 24px
       of padding was ADDED to each side, for a 407px box in a 359px parent. Every post
       page scrolled sideways. With border-box the floor means what it says (359px
       TOTAL, fits exactly) and the intent is expressible at all.
       Chosen over `min-width: calc(100% - var(--space-6) * 2)`, which would also work
       and would leave desktop untouched, because that spelling silently re-breaks the
       moment someone edits the padding on the line below — a drift with no failing
       test. Cost, stated plainly: 65vw now includes the padding, so a post's box on a
       wide screen is 48px narrower than before (at 1440px: 936px total / 888px of text,
       vs 984px / 936px). The reading measure is unchanged in kind, slightly narrower in
       px. Verified with `make measure-layout`. */
    box-sizing: border-box;
    width: 65vw;
    max-width: 1500px;
    min-width: min(100%, var(--space-reading));
    margin: 0 auto;
    padding: var(--space-16) var(--space-6) var(--space-24);
  }
  .post-header {
    border-bottom: 1px solid var(--color-border-subtle);
    padding-bottom: var(--space-8);
    margin-bottom: var(--space-10);
  }
  .brand-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }
  .mark {
    color: var(--color-accent);
    display: inline-flex;
  }
  .brand-name {
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-tight);
  }
  .divider {
    width: 1px;
    height: 14px;
    background: var(--color-border);
  }
  .brand-row .eyebrow {
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--color-accent);
  }
  h1 {
    /* Fluid, because a flat 40px was overflowing the page on a phone: at 320px the
       reading column is 256px, and "experimentation" set at 40px semibold is wider
       than that all by itself — /blog/self-healing-storefront-design/ pushed the page
       13px sideways on its TITLE. 40px is also simply too large for a 256px column.
       clamp keeps the desktop size exactly as it was (8vw passes 40px at 500px wide,
       so every real desktop still gets the 40px cap) and scales down only where it
       did not fit. */
    font-size: clamp(28px, 8vw, 40px);
    /* And a floor under that: clamp fixes the titles we have, this fixes the titles
       we don't. One compound word longer than the column would silently move the
       whole page again, and a heading that wraps mid-word is a far smaller problem
       than a page that scrolls sideways. */
    overflow-wrap: anywhere;
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-tight);
    line-height: var(--lh-tight);
    margin: 0 0 var(--space-4);
  }
  .meta {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--color-text-muted);
  }
  .questions {
    background: var(--color-surface-sunken);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-5) var(--space-6);
    margin-bottom: var(--space-10);
  }
  .questions h2 {
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 var(--space-3);
  }
  .questions ul {
    margin: 0;
    padding-left: var(--space-5);
    color: var(--color-text-secondary);
    line-height: var(--lh-body);
  }
  .questions li + li {
    margin-top: var(--space-2);
  }
  .post-footer {
    margin-top: var(--space-14);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border-subtle);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .tags {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  .back {
    font-size: var(--fs-sm);
    color: var(--color-text-secondary);
    border: none;
    text-decoration: none;
    white-space: nowrap;
  }
  .back:hover {
    color: var(--color-text-accent);
  }
</style>
